{
  "name": "code-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code, Codex and Antigravity CLI as a team of coding agents using your own subscriptions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-ui.mjs",
    "start": "node scripts/build-ui.mjs && tsx src/server.ts",
    "dev": "PORT=4318 CODEFLOW_HOME=.codeflow-dev node scripts/dev.mjs --fake-agents",
    "dev:real": "PORT=4318 CODEFLOW_HOME=.codeflow-dev node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.e2e.ts",
    "evaluate:teams": "tsx scripts/evaluate-teams.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.12",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "uqr": "^0.1.3"
  }
}
