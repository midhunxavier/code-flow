{
  "name": "code-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Run Claude Code, Codex and Antigravity CLI as a team of coding agents using your own subscriptions.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-ui.mjs && node scripts/build-host.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "npm run build && tsx src/server.ts",
    "dev": "PORT=4318 CODEFLOW_HOME=.codeflow-dev node scripts/dev.mjs --fake-agents",
    "dev:real": "PORT=4318 CODEFLOW_HOME=.codeflow-dev node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "test:e2e": "tsx --test --test-concurrency=2 test/e2e/*.e2e.ts",
    "test:acp:live": "node --import tsx scripts/test-acp-live.mjs",
    "test:vscode": "node scripts/test-vscode.mjs",
    "package:vscode": "python3 scripts/package-vscode.py",
    "evaluate:teams": "tsx scripts/evaluate-teams.ts",
    "client": "node scripts/codeflow.mjs",
    "maintenance": "tsx scripts/maintenance.ts",
    "test:containers": "CODEFLOW_TEST_DOCKER=1 tsx --test --test-concurrency=1 test/agent-container-docker.test.ts test/filtered-tasks-docker.test.ts",
    "build:host": "node scripts/build-ui.mjs && node scripts/build-host.mjs",
    "evaluate:project-teams": "tsx scripts/evaluate-project-teams.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "axe-core": "4.14.0",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@preact/signals": "^1.3.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.12",
    "preact": "^10.29.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "uqr": "^0.1.3"
  }
}
